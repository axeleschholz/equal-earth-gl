  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "white"
      }
    },
    {
      "id": "raster",
      "type": "raster",
      "source": "osm",
      "paint": {
        "raster-opacity": 1.0
      }
    },
    {
      "id": "box",
      "type": "fill",
      "source": "geojson",
      "filter": [
        "==",
        "$type",
        "Polygon"
      ],
      "paint": {
        "fill-color": "rgba(255,0,0,0.4)"
      }
    },
    {
      "id": "line",
      "type": "line",
      "source": "geojson",
      "filter": [
        "==",
        "$type",
        "LineString"
      ],
      "paint": {
        "line-color": "#00f",
        "line-width": 3
      }
    },
    {
      "id": "pt",
      "type": "circle",
      "source": "geojson",
      "filter": [
        "==",
        "$type",
        "Point"
      ],
      "paint": {
        "circle-radius": 8,
        "circle-color": "#0a0",
        "circle-stroke-width": 2,
        "circle-stroke-color": "#fff"
      }
    }
  ],
  "terrain": {
    "source": "terrain",
    "exaggeration": 2
  },
  "projection": {
    "type": "equal-earth"
  }
