{
  "version": 8,
  "metadata": {
    "test": {
      "description": "Mercator raster tiles and coastlines from a mercator vector tile as the whole world centered on 150 degrees east: both ends of the world are filled, and nothing is drawn twice or beside it.",
      "width": 512,
      "height": 256
    }
  },
  "center": [
    150,
    0
  ],
  "zoom": 0,
  "projection": {
    "type": "equal-earth",
    "central-meridian": 150
  },
  "sources": {
    "source": {
      "type": "raster",
      "tiles": [
        "local://tiles/{z}-{x}-{y}.satellite.png"
      ],
      "minzoom": 1,
      "maxzoom": 1,
      "tileSize": 256
    },
    "water": {
      "type": "vector",
      "maxzoom": 0,
      "tiles": [
        "local://tiles/{z}-{x}-{y}.mvt"
      ]
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "white"
      }
    },
    {
      "id": "raster",
      "type": "raster",
      "source": "source",
      "paint": {
        "raster-fade-duration": 0
      }
    },
    {
      "id": "coast",
      "type": "line",
      "source": "water",
      "source-layer": "water",
      "paint": {
        "line-color": "#ffff00",
        "line-width": 1
      }
    }
  ]
}
