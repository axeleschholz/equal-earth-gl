      "type": "line",
      "source": "tiles",
      "source-layer": "road",
      "paint": {
        "line-color": "#999",
        "line-width": 1
      }
    },
    {
      "id": "heat",
      "type": "heatmap",
      "source": "tiles",
      "source-layer": "poi_label",
      "paint": {
        "heatmap-radius": 12,
        "heatmap-intensity": 0.3
      }
    }
  ]
}