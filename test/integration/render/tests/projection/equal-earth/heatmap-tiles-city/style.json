{
  "version": 8,
  "metadata": {
    "test": {
      "description": "A heatmap from mercator vector tiles at zoom 14 lies on the streets the same tiles draw.",
      "width": 512,
      "height": 512
    }
  },
  "center": [
    13.418056,
    52.499167
  ],
  "zoom": 14.7,
  "projection": {
    "type": "equal-earth"
  },
  "sources": {
    "tiles": {
      "type": "vector",
      "maxzoom": 14,
      "tiles": [
        "local://tiles/{z}-{x}-{y}.mvt"
      ]
    }
  },
  "layers": [
    {
      "id": "bg",
      "type": "background",
      "paint": {
        "background-color": "#f2f2f2"
      }
    },
    {
      "id": "road",
      "type": "line",
      "source": "tiles",
      "source-layer": "road",
      "paint": {
        "line-color": "#999",
        "line-width": 1
      }
    },
    {
      "id": "heat",
      "type": "heatmap",
      "source": "tiles",
      "source-layer": "poi_label",
      "paint": {
        "heatmap-radius": 20,
        "heatmap-intensity": 0.6
      }
    }
  ]
}