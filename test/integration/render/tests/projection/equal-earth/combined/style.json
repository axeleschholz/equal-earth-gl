{
  "version": 8,
  "metadata": {
    "test": {
      "description": "Raster, fill and line layers together at zoom 1.",
      "width": 512,
      "height": 384
    }
  },
  "center": [
    20,
    20
  ],
  "zoom": 1,
  "projection": {
    "type": "equal-earth"
  },
  "sources": {
    "vector_tiles": {
      "type": "vector",
      "maxzoom": 0,
      "tiles": [
        "local://tiles/{z}-{x}-{y}.mvt"
      ]
    },
    "source": {
      "type": "raster",
      "tiles": [
        "local://tiles/{z}-{x}-{y}.satellite.png"
      ],
      "minzoom": 1,
      "maxzoom": 1,
      "tileSize": 256
    },
    "fill": {
      "type": "geojson",
      "data": {
        "type": "Polygon",
        "coordinates": [
          [
            [
              -180,
              -90
            ],
            [
              -180,
              90
            ],
            [
              180,
              90
            ],
            [
              180,
              -90
            ],
            [
              -180,
              -90
            ]
          ]
        ]
      }
    },
    "line": {
      "type": "geojson",
      "data": {
        "type": "LineString",
        "coordinates": [
          [
            -1440,
            -85
          ],
          [
            1440,
            85
          ]
        ]
      }
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "white"
      }
    },
    {
      "id": "raster",
      "type": "raster",
      "source": "source",
      "paint": {
        "raster-fade-duration": 0
      }
    },
    {
      "id": "land",
      "type": "fill",
      "source": "vector_tiles",
      "source-layer": "water",
      "paint": {
        "fill-color": "blue",
        "fill-opacity": 0.4
      }
    },
    {
      "id": "line",
      "type": "line",
      "source": "line",
      "paint": {
        "line-width": 10,
        "line-color": "red"
      }
    }
  ]
}